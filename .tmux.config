# plugins
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-sensible'
set -g @plugin 'catppuccin/tmux'

#set tmux to 24-bit color:
#set-option -sa terminal-overrides ",Xterm*:Tc"
set -g default-terminal "tmux-256color"

# new prefix key:
set-option -g prefix C-space
set-option -g prefix2 C-b

# mouse mode:
set -g mouse on

# Reload config:
bind-key r source-file ~/.config/tmux/tmux.conf \; display-message ".tumx.conf reloaded"

# use Alt-arrow keys to switch panes without the prefix key:
bind -n M-left select-pane -L
bind -n M-right select-pane -R
bind -n M-up select-pane -U
bind -n M-down select-pane -D

#easier pane splitting:
bind-key v split-window -h -c '#{pane_current_path}'
bind-key h split-window -v -c '#{pane_current_path}'

# shift-arrow to switch windows:
bind -n S-left previous-window
bind -n S-right next-window

# Configure the catppuccin plugin
set -g @catppuccin_flavor "mocha"
set -g @catppuccin_window_status_style "rounded"

set -g status-right-length 100
set -g status-left-length 100
set -g status-left ""
set -g status-right "#{E:@catppuccin_status_application}"
#set -agF status-right "#{E:@catppuccin_status_cpu}"
set -agF status-right "#{E:@catppuccin_status_ram}"
set -ag status-right "#{E:@catppuccin_status_session}"
set -ag status-right "#{E:@catppuccin_status_uptime}"
set -agF status-right "#{E:@catppuccin_status_battery}"

#run '~/.config/tmux/plugins/tmux-plugins/tmux-cpu/cpu.tmux'
#run '~/.config/tmux/plugins/tmux-plugins/tmux-battery/battery.tmux'

# Keep this at very bottom:
run '~/.config/tmux/plugins/tpm/tpm'
